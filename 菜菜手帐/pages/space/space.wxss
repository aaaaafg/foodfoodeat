.container { min-height: 100vh; padding-bottom: 40px; }

/* 日期头部 */
.date-header {
  padding: 24px 16px 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.date-info {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.date-text {
  font-size: 30px;
  font-weight: 800;
  color: var(--text);
  line-height: 1.15;
  letter-spacing: -0.5px;
  white-space: nowrap;
}

.date-weekday {
  font-size: 13px;
  color: var(--text-tertiary);
  font-weight: 400;
  margin-top: 2px;
}

/* 转发按钮 */
.share-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: -6px;
  box-shadow: var(--shadow-sm);
}

.share-btn:active { transform: scale(0.92); background: #e8e8ed; }
.share-btn-hover { transform: scale(0.92); background: #e8e8ed; }
.share-icon { width: 20px; height: 20px; display: block; }

/* 当前分组卡片入口 */
.space-entry {
  margin: 16px 16px 8px;
  padding: 16px 18px;
  background: var(--card-bg);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}

.space-entry:active { transform: scale(0.985); background: #f9f9fb; }

.space-entry-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.space-entry-icon { font-size: 30px; }

.space-entry-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.space-entry-label {
  font-size: 12px;
  color: var(--text-tertiary);
  font-weight: 500;
  letter-spacing: 0.5px;
}

.space-entry-name {
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
  max-width: 220px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.space-entry-right {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.space-entry-count {
  font-size: 12px;
  color: var(--text-tertiary);
  font-weight: 500;
}

.space-entry-arrow {
  font-size: 24px;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* 菜品列表 */
.menu-list {
  height: calc(100vh - 260px);
  padding-bottom: 12px;
}

.dish-card { transition: transform 0.15s ease; }
.dish-card:active { transform: scale(0.985); }

.dish-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.dish-name {
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
}

.dish-note-label {
  font-size: 12px;
  color: var(--primary);
  font-weight: 500;
}

.dish-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: 10px;
  flex-shrink: 0;
}

.dish-icon-btn {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.dish-icon-btn:active { background: var(--bg); }

.edit-icon {
  font-size: 15px;
  color: var(--text-tertiary);
}

.delete-icon {
  font-size: 15px;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* 备注展开区 */
.dish-note-content {
  margin-top: 12px;
  padding: 12px 14px;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.note-text {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 操作栏 */
.action-bar { padding: 8px 4px 0; }
.add-btn { width: 100%; font-size: 17px; }
.add-icon { font-size: 20px; margin-right: 6px; font-weight: 400; }
.add-btn-empty { margin-top: 20px; padding: 14px 36px; }
.action-bar-bottom {
  display: flex;
  justify-content: center;
  gap: 18px;
  margin-top: 14px;
}

.card-btn {
  padding: 12px 22px;
  font-size: 14px;
  color: var(--primary);
  font-weight: 500;
}

.clear-btn {
  padding: 12px 22px;
  font-size: 14px;
  color: var(--text-tertiary);
}

/* 分组面板内列表 */
.space-list { padding: 0 4px; max-height: 46vh; overflow-y: auto; }

.space-card {
  margin-bottom: 8px;
  background: #f9f9fb;
  border-radius: var(--radius-sm);
  padding: 14px;
  position: relative;
}

.space-active {
  border: 1.5px solid var(--primary);
  background: rgba(0, 122, 255, 0.03);
}

.space-main { display: flex; align-items: center; gap: 12px; }
.space-main:active { opacity: 0.7; }
.space-icon { font-size: 30px; }
.space-info { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.space-name { font-size: 16px; font-weight: 600; color: var(--text); }
.space-meta { font-size: 12px; color: var(--text-secondary); }

.space-badge {
  background: var(--primary);
  border-radius: 10px;
  padding: 2px 10px;
  flex-shrink: 0;
}

.space-badge text { font-size: 11px; color: #ffffff; font-weight: 600; }

.space-delete {
  position: absolute;
  right: 10px;
  bottom: 10px;
  padding: 4px 10px;
}

.space-delete:active { opacity: 0.6; }
.space-delete-text { font-size: 12px; color: var(--danger); }

.space-empty-hint { text-align: center; padding: 24px 0; }
.space-empty-hint text { font-size: 15px; color: var(--text-tertiary); }

.local-hint {
  display: block;
  text-align: center;
  font-size: 12px;
  color: var(--text-tertiary);
  margin-top: 12px;
  padding: 0 12px;
}

/* 创建分组：图标选择 */
.icon-picker {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.icon-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 10px 4px;
  border-radius: var(--radius-sm);
  border: 2px solid transparent;
  transition: all 0.15s ease;
}

.icon-option:active { transform: scale(0.94); }

.icon-active {
  border-color: var(--primary);
  background: rgba(0, 122, 255, 0.05);
}

.icon-option-emoji { font-size: 26px; }
.icon-option-label { font-size: 11px; color: var(--text-secondary); }

/* 分享卡片预览 */
.share-preview-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 20px 40px;
  box-sizing: border-box;
}

.share-preview-card {
  width: 100%;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  background: #ffffff;
}

.share-preview-img {
  width: 100%;
  display: block;
}

.share-preview-tip {
  font-size: 12px;
  color: #ffffff;
  opacity: 0.8;
  margin-top: 14px;
}

.share-preview-btns { width: 100%; }

.share-preview-btns .btn {
  padding: 12px 8px;
  font-size: 14px;
}

/* 新手引导 */
.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  animation: fadeIn 0.2s ease;
}

.guide-card {
  width: 84%;
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 28px 22px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.guide-emoji { font-size: 44px; margin-bottom: 8px; }
.guide-title { font-size: 19px; font-weight: 800; color: var(--text); }
.guide-subtitle { font-size: 13px; color: var(--text-tertiary); margin-top: 4px; margin-bottom: 20px; }

.guide-step {
  display: flex;
  gap: 12px;
  width: 100%;
  margin-bottom: 16px;
  align-items: flex-start;
}

.guide-step-num {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}

.guide-step-num text { color: #ffffff; font-size: 13px; font-weight: 700; }

.guide-step-body { display: flex; flex-direction: column; gap: 2px; }
.guide-step-title { font-size: 15px; font-weight: 600; color: var(--text); }
.guide-step-text { font-size: 13px; color: var(--text-secondary); line-height: 1.45; }

.guide-btn { width: 100%; border-radius: 24px; font-weight: 600; }

/* 隐藏的分享画布 */
.share-card-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
}

/* 弹窗表单 */
.form-group { margin-bottom: 20px; }
.form-label { font-size: 14px; color: var(--text-secondary); display: block; margin-bottom: 8px; font-weight: 500; }
.form-input { width: 100%; height: 48px; background: var(--bg); border-radius: var(--radius-sm); padding: 0 16px; font-size: 16px; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 80px; background: var(--bg); border-radius: var(--radius-sm); padding: 12px 16px; font-size: 16px; box-sizing: border-box; }
