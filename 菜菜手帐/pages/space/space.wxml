<view class="container">
  <!-- 日期头部 + 分享 -->
  <view class="date-header">
    <view class="date-info">
      <text class="date-text">{{todayDate}}</text>
      <text class="date-weekday">{{todayWeekday}}</text>
    </view>
    <button class="share-btn" open-type="share" hover-class="share-btn-hover">
      <image class="share-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
    </button>
  </view>

  <!-- 当前分组卡片入口 -->
  <view class="space-entry" bindtap="toggleSpaceManager">
    <view class="space-entry-left">
      <text class="space-entry-icon">{{spaceIcon}}</text>
      <view class="space-entry-info">
        <text class="space-entry-label">当前分组</text>
        <text class="space-entry-name">{{spaceName || '点击创建分组'}}</text>
      </view>
    </view>
    <view class="space-entry-right">
      <text class="space-entry-count">{{menu.items.length}} 道菜</text>
      <text class="space-entry-arrow">›</text>
    </view>
  </view>

  <!-- 菜品列表 -->
  <scroll-view wx:if="{{menu.items.length > 0}}" class="menu-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{menu.items}}" wx:key="id" class="dish-card card" data-id="{{item.id}}">
      <view class="dish-main">
        <view class="dish-info" bindtap="toggleNote" data-id="{{item.id}}">
          <text class="dish-name">{{item.name}}</text>
          <text wx:if="{{item.note}}" class="dish-note-label">{{item.expanded ? '收起备注' : '查看备注'}}</text>
        </view>
        <view class="dish-actions">
          <view class="dish-icon-btn" catchtap="showEditDish" data-id="{{item.id}}">
            <text class="edit-icon">✎</text>
          </view>
          <view class="dish-icon-btn" catchtap="deleteDish" data-id="{{item.id}}">
            <text class="delete-icon">✕</text>
          </view>
        </view>
      </view>
      <view wx:if="{{item.note && item.expanded}}" class="dish-note-content">
        <text class="note-text">{{item.note}}</text>
      </view>
    </view>

    <view class="action-bar">
      <button class="btn btn-primary btn-capsule add-btn" bindtap="showAddModal">
        <text class="add-icon">+</text><text>添加菜品</text>
      </button>
      <view class="action-bar-bottom">
        <button class="btn btn-ghost card-btn" bindtap="openSharePreview">🖼 菜单卡片</button>
        <button class="btn btn-ghost clear-btn" bindtap="clearAll">清空今日菜单</button>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text class="empty-state-icon">🍽️</text>
    <text class="empty-state-text">今天还没点菜</text>
    <text class="empty-state-sub">{{spaceName ? '点下面的按钮，记下想吃的菜' : '先创建一个分组开始记录吧'}}</text>
    <button wx:if="{{spaceName}}" class="btn btn-primary btn-capsule add-btn-empty" bindtap="showAddModal">
      <text class="add-icon">+</text><text>开始添加菜品</text>
    </button>
    <button wx:else class="btn btn-primary btn-capsule add-btn-empty" bindtap="startCreate">
      <text class="add-icon">+</text><text>创建分组</text>
    </button>
  </view>

  <!-- ========== 弹窗区域 ========== -->

  <!-- 分组管理面板 -->
  <view wx:if="{{showSpaceManager}}" class="modal-overlay" bindtap="hideSpaceManager">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">我的分组</text>

      <view wx:if="{{spaceList.length > 0}}" class="space-list">
        <view wx:for="{{spaceList}}" wx:key="id" class="space-card {{item.id === activeSpaceId ? 'space-active' : ''}}">
          <view class="space-main" bindtap="switchSpace" data-id="{{item.id}}">
            <text class="space-icon">{{item.icon}}</text>
            <view class="space-info">
              <text class="space-name">{{item.name}}</text>
              <text class="space-meta">互不干扰的独立菜单</text>
            </view>
            <view wx:if="{{item.id === activeSpaceId}}" class="space-badge"><text>当前</text></view>
          </view>
          <view class="space-delete" catchtap="deleteSpace" data-id="{{item.id}}">
            <text class="space-delete-text">删除</text>
          </view>
        </view>
      </view>
      <view wx:else class="space-empty-hint">
        <text>还没有分组</text>
      </view>

      <view class="form-buttons">
        <button class="btn btn-primary form-confirm" bindtap="startCreate">+ 新建分组</button>
      </view>
      <text class="local-hint">每个分组有自己独立的菜单，互不干扰</text>
    </view>
  </view>

  <!-- 创建分组 -->
  <view wx:if="{{showCreate}}" class="modal-overlay" bindtap="cancelCreate">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">新建分组</text>
      <view class="icon-picker">
        <view wx:for="{{spaceIcons}}" wx:key="key"
          class="icon-option {{newSpaceIcon === item.icon ? 'icon-active' : ''}}"
          data-icon="{{item.icon}}" bindtap="selectSpaceIcon">
          <text class="icon-option-emoji">{{item.icon}}</text>
          <text class="icon-option-label">{{item.label}}</text>
        </view>
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="分组名称，如：家庭菜单" value="{{newSpaceName}}" bindinput="onSpaceNameInput" maxlength="12"/>
      </view>
      <view class="form-buttons">
        <button class="btn btn-ghost form-cancel" bindtap="cancelCreate">取消</button>
        <button class="btn btn-primary form-confirm" bindtap="confirmCreate">创建</button>
      </view>
    </view>
  </view>

  <!-- 添加/编辑菜品 -->
  <view wx:if="{{showDishModal}}" class="modal-overlay" bindtap="hideDishModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">{{editingDishId ? '编辑菜品' : '添加菜品'}}</text>
      <view class="form-group">
        <text class="form-label">菜品名称</text>
        <input class="form-input" placeholder="例如：红烧排骨" value="{{dishName}}" bindinput="onDishNameInput" maxlength="30" focus="{{showDishModal}}"/>
      </view>
      <view class="form-group">
        <text class="form-label">备注（选填）</text>
        <textarea class="form-textarea" placeholder="多放辣椒，少盐…" value="{{dishNote}}" bindinput="onDishNoteInput" maxlength="200" auto-height/>
      </view>
      <view class="form-buttons">
        <button class="btn btn-ghost form-cancel" bindtap="hideDishModal">取消</button>
        <button class="btn btn-primary form-confirm" bindtap="submitDish">{{editingDishId ? '保存' : '确认添加'}}</button>
      </view>
    </view>
  </view>

  <!-- 清空确认 -->
  <view wx:if="{{showClearConfirm}}" class="modal-overlay" bindtap="hideClearConfirm">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">确认清空</text>
      <text class="modal-desc">确定要清空今天的所有菜品吗？此操作无法撤销。</text>
      <view class="form-buttons">
        <button class="btn btn-ghost form-cancel" bindtap="hideClearConfirm">取消</button>
        <button class="btn btn-danger form-confirm" bindtap="confirmClear">确认清空</button>
      </view>
    </view>
  </view>

  <!-- 分享卡片预览 -->
  <view wx:if="{{showSharePreview}}" class="modal-overlay" bindtap="hideSharePreview">
    <view class="share-preview-wrap" catchtap="noop">
      <view class="share-preview-card">
        <image class="share-preview-img" src="{{shareCardPath}}" mode="widthFix" show-menu-by-longpress="{{true}}"/>
      </view>
      <text class="share-preview-tip">长按图片可直接转发或保存</text>
      <view class="form-buttons share-preview-btns">
        <button class="btn btn-ghost form-cancel" bindtap="hideSharePreview">关闭</button>
        <button class="btn btn-primary form-confirm" open-type="share">转发给TA</button>
        <button class="btn btn-ghost form-cancel" bindtap="saveShareCard">保存到相册</button>
      </view>
    </view>
  </view>

  <!-- 新手引导 -->
  <view wx:if="{{showGuide}}" class="guide-overlay" bindtap="closeGuide">
    <view class="guide-card" catchtap="noop">
      <text class="guide-emoji">🍽️</text>
      <text class="guide-title">欢迎使用菜菜手帐</text>
      <text class="guide-subtitle">三步记好「今天吃什么」</text>
      <view class="guide-step">
        <view class="guide-step-num"><text>1</text></view>
        <view class="guide-step-body">
          <text class="guide-step-title">建分组</text>
          <text class="guide-step-text">一个分组就是一张菜单：家庭菜单、聚餐、减脂餐…各记各的，互不干扰</text>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-num"><text>2</text></view>
        <view class="guide-step-body">
          <text class="guide-step-title">记菜品</text>
          <text class="guide-step-text">点「添加菜品」记下名称和备注，点卡片可展开备注，✎ 随时修改</text>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-num"><text>3</text></view>
        <view class="guide-step-body">
          <text class="guide-step-title">发卡片</text>
          <text class="guide-step-text">点右上角分享或「菜单卡片」，把带头像、昵称、日期和备注的卡片发给TA</text>
        </view>
      </view>
      <button class="btn btn-primary guide-btn" bindtap="closeGuide">开始使用</button>
    </view>
  </view>

  <!-- 分享卡片绘制画布（隐藏） -->
  <canvas type="2d" id="shareCardCanvas" class="share-card-canvas"></canvas>
</view>
