<view class="container">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <!-- 头像 - 点击即可更换 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text class="avatar-char">{{nickInitial || '👤'}}</text>
      </view>
    </button>

    <!-- 昵称 - 大点击区域 -->
    <view wx:if="{{!editingNickname}}" class="nickname-row" bindtap="startEditNickname">
      <text class="nickname-value">{{nickName}}</text>
      <text class="nickname-edit-hint">编辑</text>
    </view>
    <view wx:if="{{editingNickname}}" class="nickname-edit-row">
      <input class="nickname-edit-input" type="text" value="{{editNickValue}}" bindinput="onNicknameInput" maxlength="12" focus="{{true}}" placeholder="输入昵称" />
      <view class="nickname-edit-buttons">
        <button class="nickname-cancel-btn" bindtap="cancelEditNickname">取消</button>
        <button class="nickname-save-btn" bindtap="confirmEditNickname">保存</button>
      </view>
    </view>

    <text class="profile-tip">头像和昵称会显示在你分享的菜单卡片上</text>

    <!-- 统计 -->
    <view class="profile-stats">
      <view class="stat-item">
        <text class="stat-num">{{spaceCount}}</text>
        <text class="stat-label">个分组</text>
      </view>
    </view>
  </view>

  <!-- 操作列表 -->
  <view class="action-list">
    <view class="action-item" bindtap="goToSpace">
      <text class="action-icon">🏠</text>
      <text class="action-text">管理分组</text>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-item" bindtap="showGuide">
      <text class="action-icon">📖</text>
      <text class="action-text">使用说明</text>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <!-- 版本 -->
  <view class="version-row">
    <text>菜菜手帐 2.0.0 · 数据保存在本机</text>
  </view>
</view>
