.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
  background: var(--bg);
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40px;
}

.login-icon { font-size: 72px; margin-bottom: 16px; }
.login-title { font-size: 32px; font-weight: 800; color: var(--text); margin-bottom: 6px; letter-spacing: -0.3px; }
.login-subtitle { font-size: 16px; color: var(--text-tertiary); font-weight: 400; }

.login-form { width: 100%; display: flex; flex-direction: column; align-items: center; }

/* 头像 - 简洁小圆圈 */
.avatar-pick-btn {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  padding: 0;
  margin: 0 0 20px 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  position: relative;
}
.avatar-pick-btn::after { display: none; }

.login-avatar-img {
  width: 72px;
  height: 72px;
  border-radius: 50%;
}

.avatar-circle {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #e8e8ed;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5px dashed #c7c7cc;
}

.avatar-camera { font-size: 26px; }

/* 昵称 */
.nickname-group { width: 100%; margin-bottom: 22px; }

.nickname-input {
  width: 100%; height: 52px; background: #ffffff;
  border-radius: var(--radius); padding: 0 18px; font-size: 18px;
  box-sizing: border-box; text-align: center; font-weight: 600;
}

/* 协议 - 自定义勾选框 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-bottom: 22px;
  padding: 8px 0;
}

.cb-circle {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1.5px solid #c7c7cc;
  margin-right: 8px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.cb-checked {
  background: var(--primary);
  border-color: var(--primary);
}

.cb-tick {
  font-size: 11px;
  color: #fff;
  font-weight: 700;
}

.agreement-text {
  font-size: 13px;
  color: var(--text-secondary);
}

.agreement-link {
  font-size: 13px;
  color: var(--primary);
}
.agreement-link:active { opacity: 0.6; }

.login-btn {
  width: 100%; height: 54px; background: var(--primary); color: #ffffff;
  border-radius: var(--radius); font-size: 18px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(0, 122, 255, 0.28);
}
.login-btn:active { transform: scale(0.97); }
.login-btn[disabled] { opacity: 0.5; }

/* 登录说明 */
.login-hint {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 24px;
}

.login-hint-text {
  font-size: 13px;
  color: #aeaeb2;
}

/* 条款弹窗 */
.terms-modal-content {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 28px 20px calc(40px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  animation: slideUp 0.28s ease;
}

.terms-body {
  flex: 1;
  max-height: 45vh;
  margin-bottom: 12px;
}

.terms-section { margin-bottom: 20px; }

.terms-heading {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  display: block;
  margin-bottom: 10px;
}

.terms-para {
  font-size: 13px;
  color: #3c3c43;
  line-height: 2;
  display: block;
}
