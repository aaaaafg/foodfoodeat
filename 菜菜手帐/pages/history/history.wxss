.container { min-height: 100vh; }

.history-space-label {
  padding: 12px 20px 4px;
}

.history-space-text {
  font-size: 13px;
  color: var(--primary);
  font-weight: 600;
}

.history-list {
  height: calc(100vh - 100px);
  padding: 4px 0 20px;
  box-sizing: border-box;
}

/* 历史卡片 */
.history-card { transition: transform 0.15s ease; }

/* 卡片头部 */
.history-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.history-header-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.history-date {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
}

.history-people {
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 500;
}

.history-card-space {
  font-size: 12px;
  color: var(--primary);
  font-weight: 500;
  background: rgba(0, 122, 255, 0.06);
  padding: 2px 10px;
  border-radius: 10px;
  align-self: flex-start;
}

.history-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.history-count {
  font-size: 13px;
  color: var(--text-tertiary);
}

.expand-arrow {
  font-size: 14px;
  color: var(--text-tertiary);
  padding: 2px 0;
}

.delete-day-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.delete-day-btn:active { background: var(--danger-light); }

.delete-day-icon {
  font-size: 13px;
  color: var(--text-tertiary);
}

/* 快速预览：菜品名标签 */
.history-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--separator);
}

.preview-chip {
  font-size: 12px;
  color: var(--text-secondary);
  background: var(--bg);
  padding: 4px 10px;
  border-radius: 8px;
  font-weight: 500;
}

/* 展开的菜品列表 */
.history-dishes {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--separator);
}

.history-dish-item {
  display: flex;
  align-items: flex-start;
  padding: 8px 0;
}

.history-dish-item:not(:last-child) {
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.history-dish-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 7px;
  margin-right: 12px;
  flex-shrink: 0;
}

.history-dish-content {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
}

.history-dish-name {
  font-size: 16px;
  color: var(--text);
  font-weight: 600;
}

.history-dish-author {
  font-size: 12px;
  color: var(--text-tertiary);
}

.history-dish-note {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-top: 2px;
}

/* 清空区域 */
.clear-all-bar {
  display: flex;
  justify-content: center;
  padding: 20px 16px 36px;
}

.clear-all-bar .btn-ghost {
  padding: 12px 28px;
  font-size: 14px;
  color: var(--text-tertiary);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120px 40px;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--bg);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 12px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 14px;
  color: var(--text-tertiary);
}

/* 加载更多 */
.load-more-bar {
  display: flex;
  justify-content: center;
  padding: 12px 16px;
}

.load-more-btn {
  padding: 10px 32px;
  font-size: 14px;
  color: var(--primary);
  font-weight: 500;
}

.loading-inline {
  display: flex;
  justify-content: center;
  padding: 8px 16px;
}

.loading-inline text {
  font-size: 13px;
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-state-sub {
  font-size: 14px;
  color: var(--text-tertiary);
  margin-top: 6px;
}
